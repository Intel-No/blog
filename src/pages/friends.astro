---
import { getEntry, render } from "astro:content";
import { Icon } from "astro-icon/components";

import { LinkPresets } from "@constants/link-presets";
import { LinkPreset } from "@/types/config";
import { friendsData } from "@utils/friends";
import Markdown from "@components/common/markdown.astro";
import Comment from "@components/comment.astro";
import GridLayout from "@layouts/grid.astro";
import BackwardButton from "@components/backwardButton.astro";


const friendsPost = await getEntry("spec", "friends");
if (!friendsPost) {
    throw new Error("friends page content not found");
}
const pageTitle = friendsPost.data.title || LinkPresets[LinkPreset.Friends].name;
const pageDescription = friendsPost.data.description || LinkPresets[LinkPreset.Friends].description;

const { Content, headings } = await render(friendsPost);
const items = friendsData;

const siteInformation = [
    { label: "站点名称", value: "云泽の小屋" },
    { label: "站点描述", value: "一个记录技术探索、学习实践与网络安全的小站" },
    { label: "站点链接", value: "https://zeyun.org" },
    { label: "头像链接", value: "https://zeyun.org/favicon/Happy_Mac.PNG" },
] as const;
const siteInformationText = siteInformation
    .map((item) => `${item.label}：${item.value}`)
    .join("\n");

// 将页面主标题添加到目录中
const allHeadings = [
    { depth: 1, slug: "friends-page-title", text: pageTitle },
    ...headings,
    { depth: 2, slug: "site-information", text: "本站信息" },
];

---

<GridLayout title={pageTitle} description={pageDescription} headings={allHeadings}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32 mb-4">
        <div class="card-base z-10 px-9 py-6 relative w-full ">
            <BackwardButton currentPath={Astro.url.pathname} />
            <!-- 标题 -->
            <header class="mb-8">
                <h1 id="friends-page-title" class="text-3xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
                    {pageTitle}
                </h1>
                {pageDescription && (
                    <p class="text-neutral-600 dark:text-neutral-400">
                        {pageDescription}
                    </p>
                )}
            </header>
            <!-- 链接网格 -->
            <div class="grid grid-cols-1 sm:grid-cols-2 items-stretch gap-6 my-4">
                {items.map((item) => (
                    <a href={item.siteurl} target="_blank" rel="noopener noreferrer" class="menu-card group flex flex-row items-center min-h-28 h-full p-4 rounded-xl border transition-all duration-300 gap-4">
                        <div class="icon-wrapper w-20 h-20 shrink-0 flex items-center justify-center rounded-full transition-all duration-300 overflow-hidden bg-zinc-200 dark:bg-zinc-900">
                            <img src={item.imgurl} alt={item.title} class="w-full h-full object-cover transition duration-300 group-hover:scale-110" />
                        </div>
                        <div class="flex min-w-0 flex-1 flex-col justify-center">
                            <h2 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors duration-300 break-words">
                                {item.title}
                            </h2>
                            <p class="text-sm leading-relaxed text-neutral-600 dark:text-neutral-400 whitespace-normal break-words mt-1">
                                {item.desc}
                            </p>
                            {item.tags && item.tags.length > 0 && (
                                <div class="flex flex-wrap gap-1.5 mt-2">
                                    {item.tags.slice(0, 2).map((tag) => (
                                        <span class="text-[10px] px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-700">
                                            {tag}
                                        </span>
                                    ))}
                                    {item.tags.length > 2 && (
                                        <span class="text-[10px] px-2 py-0.5 text-neutral-400">
                                            +{item.tags.length - 2}
                                        </span>
                                    )}
                                </div>
                            )}
                        </div>
                    </a>
                ))}
            </div>
            <Markdown class="mt-2">
                <Content />
            </Markdown>
            <section class="mt-10" aria-labelledby="site-information" data-pagefind-body>
                <h2 id="site-information" class="mb-5 text-2xl font-bold text-90">本站信息</h2>
                <div class="relative overflow-hidden rounded-(--radius-large) bg-(--license-block-bg) px-6 py-5 transition-colors duration-150">
                    <dl class="relative z-10 m-0 grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
                        {siteInformation.map((item) => (
                            <div class="min-w-0">
                                <dt class="text-sm text-black/30 transition-colors dark:text-white/30">{item.label}</dt>
                                <dd class="m-0 mt-1 min-w-0 text-base leading-relaxed text-black/75 transition-colors dark:text-white/75">
                                    <span class="break-all">{item.value}</span>
                                </dd>
                            </div>
                        ))}
                    </dl>
                    <div class="relative z-10 mt-6 flex flex-col gap-3 sm:flex-row sm:items-center">
                        <button
                            type="button"
                            class="site-info-copy inline-flex min-h-11 w-fit shrink-0 items-center justify-center gap-2 rounded-xl bg-(--btn-regular-bg) px-4 py-2 text-sm font-medium text-(--btn-content) transition-all duration-150 hover:bg-(--btn-regular-bg-hover) active:scale-95 active:bg-(--btn-regular-bg-active)"
                            data-site-info-copy
                            data-copy-value={siteInformationText}
                            aria-label="复制全部本站信息"
                        >
                            <Icon name="material-symbols:content-copy-outline-rounded" class="copy-icon text-lg" aria-hidden="true" />
                            <Icon name="material-symbols:check-rounded" class="success-icon hidden text-lg" aria-hidden="true" />
                            <span class="copy-label" aria-live="polite">复制代码</span>
                        </button>
                        <p class="m-0 text-sm leading-relaxed text-black/40 transition-colors dark:text-white/40">
                            一键复制全部信息，方便提交友链申请
                        </p>
                    </div>
                    <Icon name="material-symbols:link" class="pointer-events-none absolute top-1/2 right-4 text-[12rem] text-black/5 transition-colors -translate-y-1/2 dark:text-white/5" aria-hidden="true" />
                </div>
            </section>
        </div>
    </div>
    <Comment path="/friends/" />
</GridLayout>

<style>
    .menu-card {
        cursor: pointer;
        background-color: none;
        border-color: var(--line-divider);
    }

    .icon-wrapper {
        background-color: color-mix(in oklch, var(--primary), transparent 85%);
        color: var(--primary);
    }

    .menu-card:hover {
        background-color: color-mix(in oklch, var(--primary), transparent 95%);
        border-color: var(--primary);
        box-shadow: 0 0 20px color-mix(in oklch, var(--primary), transparent 80%);
        translate: 0 -4px;
    }

    .menu-card:hover .icon-wrapper {
        background-color: var(--primary);
        color: white;
        box-shadow: 0 0 15px color-mix(in oklch, var(--primary), transparent 50%);
    }

    .site-info-copy:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
    }
</style>

<script>
    const copySiteInformation = async (text: string) => {
        if (!navigator.clipboard || !window.isSecureContext) {
            throw new Error("Clipboard API is unavailable");
        }
        await navigator.clipboard.writeText(text);
    };

    const initSiteInformationCopy = () => {
        document.querySelectorAll<HTMLButtonElement>("[data-site-info-copy]").forEach((button) => {
            if (button.dataset.copyReady === "true") return;
            button.dataset.copyReady = "true";

            button.addEventListener("click", async () => {
                const value = button.dataset.copyValue;
                const label = button.querySelector<HTMLElement>(".copy-label");
                const copyIcon = button.querySelector<HTMLElement>(".copy-icon");
                const successIcon = button.querySelector<HTMLElement>(".success-icon");
                if (!value || !label) return;

                const previousTimer = Number(button.dataset.copyResetTimer);
                if (previousTimer) window.clearTimeout(previousTimer);

                try {
                    await copySiteInformation(value);
                    label.textContent = "已复制";
                    copyIcon?.classList.add("hidden");
                    successIcon?.classList.remove("hidden");
                } catch (error) {
                    console.error("复制本站信息失败:", error);
                    label.textContent = "复制失败";
                }

                const resetTimer = window.setTimeout(() => {
                    label.textContent = "复制代码";
                    copyIcon?.classList.remove("hidden");
                    successIcon?.classList.add("hidden");
                    delete button.dataset.copyResetTimer;
                }, 1800);
                button.dataset.copyResetTimer = String(resetTimer);
            });
        });
    };

    initSiteInformationCopy();
    document.addEventListener("astro:after-swap", initSiteInformationCopy);
</script>
